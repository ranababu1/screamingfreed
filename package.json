{
  "name": "screamingfreed",
  "version": "1.0.0",
  "description": "A lightweight CLI auditor for hyperlinks inside WordPress article bodies.",
  "type": "module",
  "bin": {
    "screamingfreed": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx scripts/dev-server.ts",
    "dev:cli": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck:api": "tsc -p tsconfig.vercel.json"
  },
  "keywords": [
    "seo",
    "link-checker",
    "wordpress",
    "crawler",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.3",
    "@vercel/node": "^16.0.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "p-limit": "^7.3.3",
    "tldts": "^7.4.15",
    "undici": "^8.11.2"
  }
}
